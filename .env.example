# Required
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs of the owner(s). Get yours from @userinfobot or /id
ADMIN_IDS=

# Optional: extra Telegram IDs allowed to use the bot (e.g. club members). Empty = owner-only.
ALLOWED_USER_IDS=

DATABASE_URL=sqlite:///./data/uday_ai.db
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# AI: "ollama" (local, free) | "openai_compatible" (optional hosted free tier) | "none"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Name of a model you pulled, e.g. the one from `ollama list`. Empty = AI disabled (bot still works).
OLLAMA_MODEL=
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=4000
AI_HISTORY_MESSAGES=10
AI_DAILY_REQUEST_LIMIT=30
RATE_LIMIT_PER_MINUTE=15

# Optional Mode B (only if YOU verified the provider's current free tier). Keep empty otherwise.
HOSTED_AI_BASE_URL=
HOSTED_AI_API_KEY=
HOSTED_AI_MODEL=

ENABLE_DAILY_BRIEFING=false
DAILY_BRIEFING_TIME=07:00
